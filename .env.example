# ============================================
# VinUni HRA - Environment Configuration Example
# Copy this file to .env and fill in your values
# ============================================

# --- Backend API ---
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/v1

# --- Supabase Configuration ---
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Storage Buckets
SUPABASE_STORAGE_BUCKET_CV=cv-originals
SUPABASE_STORAGE_BUCKET_EXTRACTED=cv-extracted-text

# --- File Upload Limits ---
MAX_FILE_SIZE_BYTES=10000000
MAX_FILES_PER_BATCH=50
MAX_BATCH_SIZE_BYTES=250000000

# --- AI / LLM Configuration ---
# Default to local LLM; set LLM_PROVIDER=openai or azure to use external
LLM_PROVIDER=local
LLM_MODEL_NAME=vinuni/hra-llm-7b
LLM_API_BASE=http://localhost:8001/v1
LLM_API_KEY=
LLM_TEMPERATURE_DEFAULT=0.1
ALLOW_EXTERNAL_API=false

# --- Matching Policy ---
MANDATORY_CRITERIA_WEIGHT_DEFAULT=0.7
NICE_TO_HAVE_WEIGHT_DEFAULT=0.3
MIN_EVIDENCE_COVERAGE=0.7
STRONG_MATCH_SCORE=100
MATCH_SCORE=80
NO_MATCH_SCORE=0

# --- Retention Policy ---
RETENTION_MONTHS=12

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# --- Security ---
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Frontend ---
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_API_URL=http://localhost:8000

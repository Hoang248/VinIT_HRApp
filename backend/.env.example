# VinUni HRA Backend Environment Configuration
# Copy to .env and fill in values. Keep .env out of version control.

# Application
APP_ENV=development
APP_NAME="VinUni HRA API"
DEBUG=true
API_V1_PREFIX=/v1

# Database — Direct PostgreSQL connection to Supabase
# Host: db.myrymlqdbyqmpynesiwk.supabase.co
# Port: 5432 (or 6543 for transaction pooler / pgbouncer)
# User: postgres
# Password: get from Supabase Dashboard → Project Settings → Database → Database password
DATABASE_URL=postgresql://postgres:<YOUR_DB_PASSWORD>@db.myrymlqdbyqmpynesiwk.supabase.co:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=5

# Supabase (project ref: myrymlqdbyqmpynesiwk, region ap-southeast-1)
# These keys are used for:
#   - JWT verification on API requests
#   - Storage file uploads (when STORAGE_BACKEND=supabase)
#   - Supabase Auth integration
SUPABASE_URL=https://myrymlqdbyqmpynesiwk.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im15cnltbHFkYnlxbXB5bmVzaXdrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM4NjE0NTgsImV4cCI6MjEwOTQzNzQ1OH0.qO0J1ImkkVDa_8yZmQ0e1skl1ickJe89sRb0lsHbojw
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im15cnltbHFkYnlxbXB5bmVzaXdrIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5Mzg2MTQ1OCwiZXhwIjoyMTA5NDM3NDU4fQ.b-vdIqrjhoQViCnGbeMAGbEa5GneG1BE0XOQWOkQ44Q
# Get JWT secret from Supabase Dashboard → Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=<YOUR_JWT_SECRET>

# Storage backend: "supabase" (recommended for cloud) or "local" (for development)
STORAGE_BACKEND=supabase
LOCAL_STORAGE_PATH=./storage
SUPABASE_STORAGE_BUCKET_CV=cv-originals
SUPABASE_STORAGE_BUCKET_EXTRACTED=cv-extracted-text

# File upload limits
MAX_FILE_SIZE_BYTES=10000000
MAX_FILES_PER_BATCH=50
MAX_BATCH_SIZE_BYTES=250000000

# AI/LLM — Default local Ollama configuration
# When Admin selects "local" via Admin UI, these values are loaded from DB.
# Env vars are fallback only.
LLM_PROVIDER=local
LLM_MODEL_NAME=llama3.1:8b
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
LLM_TEMPERATURE_DEFAULT=0.1
ALLOW_EXTERNAL_API=false

# Matching/Scoring
MIN_EVIDENCE_COVERAGE=0.7

# CORS (comma separated origins allowed to call API)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=480

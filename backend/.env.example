# Copy to backend/.env and fill in real values. Never commit credentials.
APP_ENV=development
APP_NAME="VinUni HRA API"
DEBUG=false
API_V1_PREFIX=/v1

# Supabase PostgreSQL direct connection; use TLS for cloud deployments.
DATABASE_URL=postgresql://postgres:CHANGE_ME@YOUR_DATABASE_HOST:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=5

# Supabase Auth. Asymmetric tokens (for example ES256) are verified via JWKS
# derived from SUPABASE_URL; the secret below is only for legacy HS256 tokens
# and may be left empty after those tokens are no longer accepted.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_BACKEND_ONLY_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=
# Optional overrides; normally derived from SUPABASE_URL.
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_CACHE_SECONDS=300

# Leave empty except during the one-time first-admin setup. Generate a unique,
# high-entropy token (at least 32 characters) and remove it after setup.
ADMIN_BOOTSTRAP_TOKEN=

# Supabase buckets must be private and accessed via the backend service role.
STORAGE_BACKEND=supabase
LOCAL_STORAGE_PATH=./storage
SUPABASE_STORAGE_BUCKET_CV=cv-originals
SUPABASE_STORAGE_BUCKET_EXTRACTED=cv-extracted-text
MAX_FILE_SIZE_BYTES=10000000
MAX_FILES_PER_BATCH=50
MAX_BATCH_SIZE_BYTES=250000000

# Environment defaults and operator allowlists. The allowlists still bound
# local/openai/azure choices; an Admin-managed OpenAI Compatible provider can
# define its own provider name, Base URL and model in the Admin UI.
# localhost is valid only when the model is in the same network namespace.
LLM_PROVIDER=local
LLM_PROVIDER_NAME=
LLM_MODEL_NAME=llama3.1:8b
LLM_API_BASE=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_TEMPERATURE_DEFAULT=0.1
# Required only when an Admin saves an API key for an OpenAI Compatible
# provider. Generate a Fernet key and keep it only in this backend env file;
# never commit or paste the generated value into Git. Rotating it makes
# previously saved provider keys undecryptable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CONFIG_ENCRYPTION_KEY=
# JSON arrays. The default model/endpoint above are automatically included.
# All API/worker instances must use consistent allowlists and secrets.
LLM_ALLOWED_MODELS=[]
LLM_ALLOWED_API_BASES=[]
ALLOW_EXTERNAL_API=false

MIN_EVIDENCE_COVERAGE=0.7
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ACCESS_TOKEN_EXPIRE_MINUTES=480
